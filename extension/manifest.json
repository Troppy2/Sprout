{
  "manifest_version": 3,
  "name": "Sprout",
  "version": "0.1.0",
  "description": "An MCP server and Chrome extension that lets any AI agent see and use your real browser.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sprout",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "sprout-stop": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop Sprout: pause the agent and detach from every tab"
    }
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "downloads"
  ]
}
